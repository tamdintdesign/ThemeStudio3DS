<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ThemeStudio3DS.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UsagiPath)' != ''">
    <DefineConstants>$(DefineConstants);VERIFY_WITH_USAGI</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsagiPath)' != ''">
    <Compile Include="$(UsagiPath)/ThemeEditor.Common/Themes/**/*.cs" />
    <Compile Include="$(UsagiPath)/ThemeEditor.Common/Graphics/*.cs" />
    <Compile Include="$(UsagiPath)/ThemeEditor.Common/Compression/*.cs" />
    <Compile Include="$(UsagiPath)/ThemeEditor.Common/Extensions.cs" />
  </ItemGroup>
</Project>
